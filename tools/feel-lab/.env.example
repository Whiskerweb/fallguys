# Configuration du CLIENT. Copier en `.env.local` et remplir.
#
# Vite n'expose au navigateur que les variables prefixees `VITE_` : c'est une barriere
# utile, mais elle ne rend rien secret. Tout ce qui figure ici PART DANS LE BUNDLE et se
# lit dans la console de n'importe quel joueur. N'y mettre que du public.
#
# Sans ces variables, le jeu tourne exactement comme avant : portefeuille local de 25 USDG
# fictifs, aucun compte, aucun reseau. C'est ce mode qu'utilisent les harnais de `diag/`.

# La cle `anon` est PUBLIQUE par nature. Ce qui protege derriere, c'est RLS — voir
# backend/sql/002_rls.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# L'API du backend.
VITE_API_URL=http://127.0.0.1:8787
