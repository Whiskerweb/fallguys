# Copier en .env et remplir. Le .env réel n'est jamais versionné.

# ---- pipelines d'assets ----
MESHY_API_KEY=
GOOGLE_AI_KEY=
OPENROUTER_KEY=

# ---- Supabase : comptes et base ----
# `SUPABASE_SERVICE_ROLE` contourne TOUTES les politiques d'accès. Elle ne doit jamais
# atteindre le navigateur, ni un journal, ni ce dépôt. La clé `anon`, elle, est publique
# par nature : elle part dans le bundle du jeu, et c'est RLS qui protège derrière.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
DATABASE_URL=

# ---- Robinhood Chain ----
# `testnet` par défaut (chainId 46630, RPC public https://rpc.testnet.chain.robinhood.com,
# explorateur https://explorer.testnet.chain.robinhood.com). Le mainnet (chainId 4663) doit
# être un changement de configuration, pas une chasse aux valeurs en dur : tout est ici.
ROBINHOOD_RESEAU=testnet
# Un RPC payé (Alchemy) le jour où le public limite. Vide : le RPC public du réseau.
ROBINHOOD_RPC=

# Les CONTRATS, déployés par `cd backend && npm run contrats` (il faut de l'ETH sur la
# caisse : https://faucet.testnet.chain.robinhood.com). Sur le testnet, USDC est NOTRE jeton
# d'essai (frappable par le robinet) ; sur mainnet, l'adresse du vrai USDC.
LOT_ADRESSE=
USDC_ADRESSE=
BG_ADRESSE=

# La caisse : le wallet maison, clé secp256k1 en hexadécimal (0x + 64 caractères). C'est la
# clé qui SOUMET ET PAIE LE GAZ de toutes les transactions, et qui possède les contrats.
# Sur le testnet elle ne garde rien. En mainnet, elle EST le système — et elle n'a alors
# plus sa place dans une variable d'environnement, mais dans un KMS ou un signataire matériel.
CAISSE_CLE=

# Graine maîtresse des wallets DÉRIVÉS : le wallet de jeu de chaque joueur (son adresse de
# dépôt, où ses USDC RESTENT) et le wallet du pot de chaque partie. Aucune clé privée n'est
# stockée, elles se recalculent toutes depuis cette graine. La perdre, c'est perdre l'accès
# à TOUT l'argent des joueurs. LA CHANGER AUSSI.
GRAINE_DEPOTS=

# ---- Trésorerie (générée par `cd backend && npm run tresorerie`, notée dans backend/wallets/) ----
# FRAIS reçoit le rake de chaque partie sur la chaîne ; POOL tient la liquidité BG/USDC où
# les frais achètent les BG qui sont brûlés. Testnet : le pool est le nôtre ; mainnet : un DEX.
FRAIS_CLE=
POOL_CLE=
# Le brûlage part dès que les frais atteignent ce seuil (micros). BRULAGE=0 le suspend.
BRULAGE_SEUIL_MICROS=1000000
BRULAGE=1
# Le robinet d'USDC d'essai (testnet seulement) : combien par demande, et le délai entre deux.
ROBINET_MICROS=20000000
ROBINET_DELAI_MINUTES=60

# ---- Serveur de jeu ↔ backend ----
# Le serveur de jeu SIGNE (Ed25519) les mises à engager et les résultats à régler ; le
# backend ne croit que cette signature. Les deux moitiés viennent de `npm run tresorerie`.
SERVEUR_CLE=
SERVEUR_PUBLIQUE=
# Où le serveur de jeu trouve le backend. Sans elle, PRODUCTION refuse de démarrer.
BACKEND_URL=http://127.0.0.1:8787

# ---- service ----
PORT=8787
ORIGINE_AUTORISEE=*
# Port du serveur de jeu (PORT est celui du backend). 8080 par defaut.
SERVEUR_PORT=8080
