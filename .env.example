# Copier en .env et remplir. Le .env réel n'est jamais versionné.

# ---- pipelines d'assets ----
MESHY_API_KEY=
GOOGLE_AI_KEY=
OPENROUTER_KEY=

# ---- Supabase : comptes et base ----
# `SUPABASE_SERVICE_ROLE` contourne TOUTES les politiques d'accès. Elle ne doit jamais
# atteindre le navigateur, ni un journal, ni ce dépôt. La clé `anon`, elle, est publique
# par nature : elle part dans le bundle du jeu, et c'est RLS qui protège derrière.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
DATABASE_URL=

# ---- Solana ----
# Devnet par défaut. Le mint est une variable et non une constante du code : le passage en
# mainnet doit être un changement de configuration, pas une chasse aux valeurs en dur.
SOLANA_RESEAU=devnet
SOLANA_RPC=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# La caisse : le wallet maison, en base58. C'est la clé qui SIGNE LES PAIEMENTS.
# Sur devnet elle ne garde rien. En mainnet, elle EST le système — et elle n'a alors plus
# sa place dans une variable d'environnement, mais dans un KMS ou un signataire matériel.
CAISSE_CLE=

# Graine maîtresse des wallets DÉRIVÉS : le wallet de jeu de chaque joueur (son adresse de
# dépôt, où ses USDC RESTENT) et le wallet du pot de chaque partie. Aucune clé privée n'est
# stockée, elles se recalculent toutes depuis cette graine. La perdre, c'est perdre l'accès
# à TOUT l'argent des joueurs. LA CHANGER AUSSI.
GRAINE_DEPOTS=

# ---- Trésorerie (générée par `cd backend && npm run tresorerie`, notée dans backend/wallets/) ----
# FRAIS reçoit le rake de chaque partie sur la chaîne ; POOL tient la liquidité BG/USDC où
# les frais achètent les BG qui sont brûlés. Devnet : le pool est le nôtre ; mainnet : Jupiter.
FRAIS_CLE=
POOL_CLE=
# Le jeton BG (« Baby Guy »), créé par `npm run jeton` : 1 000 000 000, frappe révoquée.
BG_MINT=
# Le brulage part dès que les frais atteignent ce seuil (micros). BRULAGE=0 le suspend.
BRULAGE_SEUIL_MICROS=1000000
BRULAGE=1

# ---- Serveur de jeu ↔ backend ----
# Le serveur de jeu SIGNE (Ed25519) les mises à engager et les résultats à régler ; le
# backend ne croit que cette signature. Les deux moitiés viennent de `npm run tresorerie`.
SERVEUR_CLE=
SERVEUR_PUBLIQUE=
# Où le serveur de jeu trouve le backend. Sans elle, PRODUCTION refuse de démarrer.
BACKEND_URL=http://127.0.0.1:8787

# ---- service ----
PORT=8787
ORIGINE_AUTORISEE=*
